@inject AuroraJournalingApp.Utils.DarkModeState DarkModeState
@inject NavigationManager navigation
@inject IJSRuntime JS

<div class="topbar">
    <div class="topbar-left">
        <span class="topbar-logo">📚</span>
        <span class="topbar-title">Aurora</span>
    </div>

    <div class="topbar-right">
        <button class="topbar-btn" @onclick="ToggleDarkMode">
            Switch theme
        </button>
        <button @onclick="onsubmit" class="topbar-btn signout">
            Log Out
        </button>
    </div>
</div>

@code {

    private bool isDark;

    protected override async Task OnInitializedAsync()
    {
        var value = await SecureStorage.GetAsync("darkmode");

        isDark = value == "true";

        await ApplyTheme(); // ✅ apply, don’t toggle
    }

    async Task ToggleDarkMode()
    {
        isDark = !isDark;

        await SecureStorage.SetAsync("darkmode", isDark ? "true" : "false");

        await ApplyTheme();
    }

    async Task ApplyTheme()
    {
        await JS.InvokeVoidAsync(
            "document.body.setAttribute",
            "data-theme",
            isDark ? "dark" : "light"
        );
    }

    public async Task onsubmit()
    {
        await SecureStorage.SetAsync("loggedin", "unauthorized");
        navigation.NavigateTo("/login");
    }
}
