<MudPaper Class="pa-4">
    @if (Data != null && Data.Any())
    {
        <MudChart ChartType="ChartType.Pie" InputData="@Data" InputLabels="@Labels" Width="300px" Height="300px" />
    }
    else
    {
        <MudText Typo="Typo.body1" Align="Align.Center">No mood data available yet.</MudText>
    }
</MudPaper>

@code {
    [Parameter] public double[] Data { get; set; } = Array.Empty<double>();
    [Parameter] public string[] Labels { get; set; } = Array.Empty<string>();
}