<MudPaper Class="doc-section-component-container">
    <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" XAxisLabels="@XAxisLabels" Width="100%" Height="350px"></MudChart>
</MudPaper>

@code {
    [Parameter] public List<ChartSeries> Series { get; set; } = new();
    [Parameter] public string[] XAxisLabels { get; set; } = Array.Empty<string>();
}