<div class="pagination-container">
    <button class="page-btn" @onclick="GoPrevious" disabled="@(CurrentPage <= 1)">Previous</button>

    <span class="page-number active">@CurrentPage</span>

    <button class="page-btn" @onclick="GoNext" disabled="@(CurrentPage >= TotalPages)">Next</button>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private async Task GoPrevious()
    {
        if (CurrentPage > 1)
        {
            await OnPageChanged.InvokeAsync(CurrentPage - 1);
        }
    }

    private async Task GoNext()
    {
        if (CurrentPage < TotalPages)
        {
            await OnPageChanged.InvokeAsync(CurrentPage + 1);
        }
    }
}
