@page "/"
@using AuroraJournalingApp.Models
@layout AuroraJournalingApp.Components.Layout.EmptyLayout
@inject AuroraJournalingApp.Data.AuroraDbContext dbservice
@using Microsoft.Maui.Storage
@inject NavigationManager navigation
<div class="login-container">
    <div class="card" style="min-width:400px;">
        <h2> Welcome Back !</h2>
        <EditForm Model="userModel" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Username:</label>
                <InputText @bind-Value="Username" class="input-field" />
            </div>

            <div class="form-group checkbox-group">
                <InputCheckbox @bind-Value="usePin" class="checkbox-field" />
                <label>Use PIN instead</label>
            </div>

            @if (!usePin)
            {
                <div class="form-group">
                    <label>Password:</label>
                    <InputText @bind-Value="Password" Type="password" class="input-field" />
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>PIN:</label>
                    <InputNumber @bind-Value="Pin" class="input-field" />
                </div>
            }

            <button type="submit" class="bluebutton">Log In</button>
        </EditForm>
    </div>
</div>

<style>
    
  
</style>

@code {
    public string Username { get; set; } = "";
    public string Password { get; set; } = "";
    public int Pin { get; set; }
    public bool usePin { get; set; } = false;

    User userModel = new User();
    List<User> userlist = new List<User>();

    protected override async Task OnInitializedAsync()
    {
        //userlist = await dbservice.GetUsersAsync();
    }


    protected async override void OnInitialized()
    {
        string oauthToken = await SecureStorage.Default.GetAsync("loggedin");


        if (oauthToken == null)
        {
            navigation.NavigateTo("/signup");
        }
    }
    public async Task OnSubmit()
    {

        var User = await SecureStorage.GetAsync("Username");
        var Pass = await SecureStorage.GetAsync("Password");

        if (Username.Equals(User) && Password.Equals(Pass))
        {

            await SecureStorage.Default.SetAsync("loggedin","authorized");
            navigation.NavigateTo("/home");
        } else {

            navigation.NavigateTo("/login");
        }
    }
}