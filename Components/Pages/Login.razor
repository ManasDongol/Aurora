@page "/"
@using AuroraJournalingApp.Models
@layout AuroraJournalingApp.Components.Layout.EmptyLayout
@inject AuroraJournalingApp.Data.AuroraDbContext dbservice
@using Microsoft.Maui.Storage
@inject NavigationManager navigation
@inject IJSRuntime JS
@inject ToastService ToastService
@inject LoadingService LoadingService


<div class="login-container">

   
    <div class="card" style="min-width:400px;">
        <h2> Welcome to Aurora !</h2>
        <EditForm Model="userModel" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Username:</label>
                <InputText @bind-Value="Username" class="input-field" placeholder="Enter username" />
            </div>




            <div class="form-group">
                <label>Password:</label>
                <InputText @bind-Value="Password" Type="password" class="input-field" placeholder="Enter password" />
            </div>

            <div style="margin-bottom:10px;">
                Forgot password? click<NavLink href="/passwordchange">here</NavLink>
            </div>
            <button type="submit" class="bluebutton" >Log In</button>
        </EditForm>
    </div>
</div>

<style>
</style>

@code {
    public string Username { get; set; } = "";
    public string Password { get; set; } = "";


    User userModel = new User();
    List<User> userlist = new List<User>();

    async Task ApplyTheme()
    {
        await JS.InvokeVoidAsync(
            "document.body.setAttribute",
            "data-theme",
            isDark ? "dark" : "light"
        );
    }



    public async Task OnSubmit()
    {
        LoadingService.Show();
        var User = await SecureStorage.GetAsync("Username");
        var Pass = await SecureStorage.GetAsync("Password");
        var email = await SecureStorage.GetAsync("Email");

        if (Username.Equals(User) && Password.Equals(Pass))
        {
            try
            {

                await SecureStorage.Default.SetAsync("loggedin", "authorized");
                await ToastService.ShowSuccess("Logged in successfully!");
                System.Diagnostics.Debug.WriteLine(email);
                System.Diagnostics.Debug.WriteLine(Pass);
                navigation.NavigateTo("/home");
            }
            catch
            {
                await ToastService.ShowError("Failed to login, try again.");
                Username = "";
                Password = "";
            }
            finally
            {
                LoadingService.Hide();
            }

        }
        else
        {
            await ToastService.ShowError("Failed to login, try again.");
            Username = "";
            Password = "";
            LoadingService.Hide();
        }
    }
}