
@page "/home"
@using AuroraJournalingApp.Components.Calendar
@using AuroraJournalingApp.Components.RichTextEditor

@inject NavigationManager navigator

<div class="container">
    @if (entrystatus)
    {



        <AuroraJournalingApp.Components.Cards.EntryJournalCard /> 

    }
    else
    {
        <AuroraJournalingApp.Components.Cards.AddJournalCard />
    }







</div>
@code {

    public string journaltitle;
    public string journaltext;

    private List<string> selectedMoods = new();
    private List<string> selectedTags = new();
   

    private bool checkjournal = false;





    public class journalcontent
    {
        public string Title { get; set; }
        public string content { get; set; }
        public DateTime DateVal { get; set; } = DateTime.UtcNow;
        public List<string> Moods { get; set; } = new();
        public List<string> Tags { get; set; } = new();
    }

    private readonly string[] _states =
    {
        "Happy","Excited","Relaxed","Grateful","Confident","Calm",
        "Thoughtful","Curious","Nostalgic","Bored","Sad","Angry",
        "Stressed","Lonely","Anxious"
    };





}

