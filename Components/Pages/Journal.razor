
@page "/home"
@using AuroraJournalingApp.Components.Calendar
@using AuroraJournalingApp.Components.RichTextEditor

@inject NavigationManager navigator

<div class="container">
    @if (_ready)
    {
       
      
    }
      
     <AuroraJournalingApp.Components.Cards.AddJournalCard/>
    

    </div>
@code {

    public string journaltitle;
    public string journaltext;

    private List<string> selectedMoods = new();
    private List<string> selectedTags = new();
    protected override async Task OnInitializedAsync()
    {
        string oauthToken = await SecureStorage.Default.GetAsync("loggedin");


        if (oauthToken == null)
        {
            navigator.NavigateTo("/signup");
        }
        if (oauthToken == "unauthorized")
        {
            navigator.NavigateTo("/login");
        }


    }
    private bool _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ready = true;
            StateHasChanged();
        }
    }



    public class journalcontent
    {
        public string Title { get; set; }
        public string content { get; set; }
        public DateTime DateVal { get; set; } = DateTime.UtcNow;
        public List<string> Moods { get; set; } = new();
        public List<string> Tags { get; set; } = new();
    }

    private readonly string[] _states =
    {
        "Happy","Excited","Relaxed","Grateful","Confident","Calm",
        "Thoughtful","Curious","Nostalgic","Bored","Sad","Angry",
        "Stressed","Lonely","Anxious"
    };

    public static List<journalcontent> journals = new();

    void AddJournal()
    {
        journals.Add(new journalcontent
        {
            Title = journaltitle,
            content = journaltext,
            Moods = selectedMoods.ToList(),
            Tags = selectedTags.ToList()
        });

        journaltitle = "";
        journaltext = "";
        selectedMoods.Clear();
        selectedTags.Clear();
    }


}

