@page "/passwordchange"
@inject UserService userservice
@using AuroraJournalingApp.DTOs
@inject LoadingService LoadingService
@layout AuroraJournalingApp.Components.Layout.EmptyLayout
@inject ToastService ToastService
@inject LoadingService LoadingService
@inject NavigationManager navigation


<div class="card">
  

    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <h1>Password change</h1>
        <div class="form-group">
            <label>Email</label>
            <InputText class="form-control"
                       @bind-Value="model.email" />
        </div>

        <div class="form-group">
            <label>New Password</label>
            <InputText type="password"
                       class="form-control"
                       @bind-Value="model.Password" />
        </div>

        <div class="form-group">
            <label>Confirm Password</label>
            <InputText type="password"
                       class="form-control"
                       @bind-Value="model.ConfirmPassword" />
        </div>
        <button class="bluebutton"> back </button>
        <button class="bluebutton">
            Change Password
        </button>


    </EditForm>

</div>

@code {

    private PasswordChangeDTO model = new();
    public void goBack()
    {
        navigation.NavigateTo("/login");
    }

    private async Task HandleSubmit()
    {

        var email = await SecureStorage.GetAsync("Email");
        try
        {
            LoadingService.Show();

            if (model.Password != model.ConfirmPassword)
            {
                throw new Exception();
            }
            if (model.email != email)
            {
                throw new Exception();
            }
            await userservice.UpdatePassword(model.email, model.Password);
            await SecureStorage.SetAsync("Password",model.Password);
            await ToastService.ShowSuccess("password changed successfully!");
            navigation.NavigateTo("/login");
        }
        catch
        {
            await ToastService.ShowError("failed to change password !");
        }
        finally
        {
            LoadingService.Hide();
        }

        Console.WriteLine("Password change submitted");
    }
}
