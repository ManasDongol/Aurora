@page "/history"
@using AuroraJournalingApp.Components.Calendar
@using AuroraJournalingApp.Services
@using AuroraJournalingApp.Models
@using AuroraJournalingApp.DTOs
@inject JournalService JournalService
@inject LoadingService LoadingService


<section class="card" style="margin-left:210px; max-width:700px;">

    <div class="maincard">
        <div>
            <Calendar OnDateChanged="OnDateSelected" />

        </div>
        <div class="form-group">
            <div class="form-group">
                <label>Search by Content</label>
                <input @bind="SearchText" placeholder="Search journal..." class="text-input" />

            </div>
            <div class="form-group">
                <label>Search by Moods</label>
                <input @bind="moodstring" placeholder="insert mood..." class="text-input" />

            </div>
            <div class="form-group">
                <label>Search by Tags</label>
                <input @bind="tagstring" placeholder="insert tag..." class="text-input" />

            </div>
            <button class="bluebutton" @onclick="PerformSearch">Search</button>
        </div>
    </div>
</section>


<div class="journal-list-container">
    @if (journallist == null)
    {
        <p>Loading...</p>
    }
    else if (journallist.Count == 0)
    {
        <div class="empty-state">
            <p>No journals found.</p>
        </div>
    }
    else
    {
        @foreach (var journal in journallist)
        {
            <!--<div class="journal-entry-card">-->
            <div class="card">

                <header class="journal-header">
                    <h3 class="journal-title">@journal.Title</h3>
                    <span class="journal-time"> @journal.Created.ToString("d")</span>

                    <button class="bluebutton" @onclick="() => JournalPdf(journal)">
                        Export Journal
                    </button>
                </header>
                <div class="meta-section">
                    <div class="chips-row">
                        @if (!string.IsNullOrEmpty(journal.primaryMood))
                        {
                            <span class="chip mood-primary">@journal.primaryMood</span>
                        }
                        @if (!string.IsNullOrEmpty(journal.secondaryMoods))
                        {
                            foreach (var mood in journal.secondaryMoods.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="chip mood-secondary">@mood.Trim()</span>
                            }
                        }
                    </div>

                    <div class="chips-row">
                        @if (!string.IsNullOrEmpty(journal.tags))
                        {
                            foreach (var tag in journal.tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="chip tag">@tag.Trim()</span>
                            }
                        }
                    </div>
                </div>
                <br />
                <div class="journal-content">
                    @((MarkupString)journal.Content)
                </div>


            </div>
        }
    }

    <AuroraJournalingApp.Components.Pagination.Pagination CurrentPage="@currentPage"
                                                          TotalPages="@totalPages"
                                                          OnPageChanged="OnPageChanged" />
</div>

