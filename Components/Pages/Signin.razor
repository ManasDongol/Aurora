@page "/signup"

@inject NavigationManager navigate
@layout AuroraJournalingApp.Components.Layout.EmptyLayout
@using System.Diagnostics;
@inject LoadingService LoadingService


<div class="signup-container">
    <div class="signup-card">
        <h2>Sign Up</h2>

        <EditForm Model="userModel" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Username:</label>
                <InputText @bind-Value="Username" class="input-field" />
            </div>

            <div class="form-group">
                <label>Password:</label>
                <InputText @bind-Value="Password" Type="password" class="input-field" />
            </div>

            <div class="form-group">
                <label>Email:</label>
                <InputText @bind-Value="Email" class="input-field" />
            </div>

            <button type="submit" class="signup-btn">Register</button>
        </EditForm>
    </div>
</div>

