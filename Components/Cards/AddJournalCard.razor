@using Microsoft.AspNetCore.Components
@inject ToastService ToastService
@inject LoadingService LoadingService


<section class="card journal-card">
    <h2 class="card-title">Today's Journal Entry</h2>

    <EditForm Model="@dto" OnValidSubmit="addJournal">
        <DataAnnotationsValidator />
        <ValidationSummary />


        <div class="form-group">
            <label class="label">Title</label>
            <input class="text-input title-input"
                   placeholder="Give today a title…"
                   @bind="dto.Title" />
        </div>

        <div class="form-group">
            <label class="label">Body</label>
            @if (isLoaded)
            {


                <SfRichTextEditor @bind-Value="@dto.Content" Placeholder="Write your journal..." />
            }

        </div>
        <div style="display:flex;justify-content:space-between">

            <div>
                <label class="label">Moods</label>
                <div class="dropdown @(isMoodOpen ? "open" : "")">
                    <div class="dropdown-btn" @onclick="ToggleMood">
                        <span class="selected-text">
                            @(selectedMoods.Any()
                        ? string.Join(", ", selectedMoods)
                        : "Select moods (max 3)")
                        </span>
                    </div>
                    <div class="dropdown-content">
                        @foreach (var mood in MoodOptions)
                        {
                            <label>
                                <input type="checkbox"
                                       checked="@selectedMoods.Contains(mood)"
                                       @onchange="() => ToggleMoodSelection(mood)" />
                                @mood
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div>

                <label class="label">Tags</label>
                <div class="dropdown @(isTagOpen ? "open" : "")">
                    <div class="dropdown-btn" @onclick="ToggleTag">
                        <span class="selected-text">
                            @(selectedTags.Any()
                        ? string.Join(", ", selectedTags)
                        : "Select tags (max 5)")
                        </span>
                    </div>
                    <div class="dropdown-content">
                        @foreach (var tag in TagOptions)
                        {
                            <label>
                                <input type="checkbox"
                                       checked="@selectedTags.Contains(tag)"
                                       @onchange="() => ToggleTagSelection(tag)" />
                                @tag
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="actions">
                <button class="bluebutton" type="submit">
                    @(editJournal ? "Update Entry" : "Save Entry")
                </button>
            </div>
        </div>
       

    </EditForm>


</section>
<style>
 
    .e-richtexteditor .e-rte-container {
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--bg-color);
    }
    .e-richtexteditor ::placeholder {
        color: var(--text-color);
    }
    
    .e-richtexteditor .e-rte-content,
    .e-richtexteditor .e-source-content {
        background: var(--bg-color);
        color: var(--text-color);
    }

        .e-richtexteditor .e-rte-content .e-content,
        .e-richtexteditor .e-source-content .e-content {
            font-size: 18px;
        }




</style>
@code {

    bool isMoodOpen;
    bool isTagOpen;



    List<string> selectedMoods = new();
    List<string> selectedTags = new();


    public string RteValue { get; set; } = "";
    public JournalDTO dto = new()
    {
        Content = "",
        Title = ""
    };


    private async Task OnRteValueChanged(string value)
    {
        RteValue = value;
        await Task.CompletedTask; // optional
    }
    readonly string[] MoodOptions =
{
        "Happy","Excited","Relaxed","Grateful","Confident","Calm",
        "Thoughtful","Curious","Nostalgic","Bored","Sad","Angry",
        "Stressed","Lonely","Anxious"
    };

    readonly string[] TagOptions =
    {
        "Work", "Career", "Studies", "Family", "Friends", "Relationships",
        "Health", "Fitness", "Personal Growth", "Self-care", "Hobbies",
        "Travel", "Nature", "Finance", "Spirituality", "Birthday",
        "Holiday", "Vacation", "Celebration", "Exercise", "Reading",
        "Writing", "Cooking", "Meditation", "Yoga", "Music", "Shopping",
        "Parenting", "Projects", "Planning", "Reflection"
    };


    void ToggleMood()
    {
        isMoodOpen = !isMoodOpen;
        isTagOpen = false;
    }

    void ToggleTag()
    {
        isTagOpen = !isTagOpen;
        isMoodOpen = false;
    }

    // ───────────── SELECTION LOGIC ─────────────
    void ToggleMoodSelection(string mood)
    {
        if (selectedMoods.Contains(mood))
            selectedMoods.Remove(mood);
        else if (selectedMoods.Count < 3)
            selectedMoods.Add(mood);
    }

    void ToggleTagSelection(string tag)
    {
        if (selectedTags.Contains(tag))
            selectedTags.Remove(tag);
        else if (selectedTags.Count < 5)
            selectedTags.Add(tag);
    }


}
